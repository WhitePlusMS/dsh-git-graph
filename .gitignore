# 依赖目录
node_modules/

# 编辑器和本地工作区配置
.vscode/
.idea/
*.code-workspace

# 按项目约定不提交测试目录及测试运行产物
tests/
test-results/
coverage/

# 插件发布入口依赖构建产物；必须随 GitHub tag 一起发布
dist/
out/
*.tsbuildinfo

# 上游 VS Code Git Graph 参考源码，不属于本插件源码
/vscode-git-graph/

# 本地缓存、临时文件和日志
.cache/
.tmp/
tmp/
temp/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 本地环境配置和打包文件
.env
.env.*
!.env.example
*.tgz
*.vsix

# 操作系统生成文件
.DS_Store
Thumbs.db
desktop.ini
